<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Over Cast</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="styles/main.css">
</head>
<body>
  <div class="container">
    <div class="logo">
      <!-- logo -->
      <h1>Overcast</h1> 
    </div>
    <div class="main-content">
      <p>Enter your location</p>
      <form class="form" method="POST" action="/postCords">
        <input type="text" name="city" placeholder="City">
        <button id="post" type="submit" value="POST">Submit</button>
      </form>
    </div>
  </div>
</body>
</html>